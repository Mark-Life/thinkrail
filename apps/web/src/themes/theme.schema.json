{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://thinkrail.dev/schemas/theme-manifest-v1.json",
	"type": "object",
	"properties": {
		"$schema": {
			"type": "string"
		},
		"schemaVersion": {
			"const": 2
		},
		"id": {
			"type": "string",
			"pattern": "^[a-z0-9](?:[a-z0-9._-]{0,63})$"
		},
		"label": {
			"type": "string",
			"pattern": "\\S"
		},
		"order": {
			"type": "integer"
		},
		"appearance": {
			"enum": ["light", "dark"]
		},
		"contrast": {
			"enum": ["normal", "high"]
		},
		"colors": {
			"type": "object",
			"properties": {
				"accent": {
					"type": "string",
					"pattern": "^#[0-9a-f]{6}(?:[0-9a-f]{2})?$"
				},
				"accentHover": {
					"type": "string",
					"pattern": "^#[0-9a-f]{6}(?:[0-9a-f]{2})?$"
				},
				"accentSolid": {
					"type": "string",
					"pattern": "^#[0-9a-f]{6}(?:[0-9a-f]{2})?$"
				},
				"onAccent": {
					"type": "string",
					"pattern": "^#[0-9a-f]{6}(?:[0-9a-f]{2})?$"
				},
				"bubbleAccent": {
					"type": "string",
					"pattern": "^#[0-9a-f]{6}(?:[0-9a-f]{2})?$"
				},
				"background": {
					"type": "string",
					"pattern": "^#[0-9a-f]{6}(?:[0-9a-f]{2})?$"
				},
				"header": {
					"type": "string",
					"pattern": "^#[0-9a-f]{6}(?:[0-9a-f]{2})?$"
				},
				"content": {
					"type": "string",
					"pattern": "^#[0-9a-f]{6}(?:[0-9a-f]{2})?$"
				},
				"sidebar": {
					"type": "string",
					"pattern": "^#[0-9a-f]{6}(?:[0-9a-f]{2})?$"
				},
				"input": {
					"type": "string",
					"pattern": "^#[0-9a-f]{6}(?:[0-9a-f]{2})?$"
				},
				"elevated": {
					"type": "string",
					"pattern": "^#[0-9a-f]{6}(?:[0-9a-f]{2})?$"
				},
				"hover": {
					"type": "string",
					"pattern": "^#[0-9a-f]{6}(?:[0-9a-f]{2})?$"
				},
				"border": {
					"type": "string",
					"pattern": "^#[0-9a-f]{6}(?:[0-9a-f]{2})?$"
				},
				"borderStrong": {
					"type": "string",
					"pattern": "^#[0-9a-f]{6}(?:[0-9a-f]{2})?$"
				},
				"text": {
					"type": "string",
					"pattern": "^#[0-9a-f]{6}(?:[0-9a-f]{2})?$"
				},
				"muted": {
					"type": "string",
					"pattern": "^#[0-9a-f]{6}(?:[0-9a-f]{2})?$"
				},
				"hint": {
					"type": "string",
					"pattern": "^#[0-9a-f]{6}(?:[0-9a-f]{2})?$"
				},
				"selection": {
					"type": "string",
					"pattern": "^#[0-9a-f]{6}(?:[0-9a-f]{2})?$"
				},
				"selectionForeground": {
					"anyOf": [
						{
							"type": "string",
							"pattern": "^#[0-9a-f]{6}(?:[0-9a-f]{2})?$"
						},
						{
							"type": "null"
						}
					]
				},
				"editorSelection": {
					"type": "string",
					"pattern": "^#[0-9a-f]{6}(?:[0-9a-f]{2})?$"
				},
				"editorSelectionForeground": {
					"anyOf": [
						{
							"type": "string",
							"pattern": "^#[0-9a-f]{6}(?:[0-9a-f]{2})?$"
						},
						{
							"type": "null"
						}
					]
				},
				"info": {
					"type": "string",
					"pattern": "^#[0-9a-f]{6}(?:[0-9a-f]{2})?$"
				},
				"success": {
					"type": "string",
					"pattern": "^#[0-9a-f]{6}(?:[0-9a-f]{2})?$"
				},
				"danger": {
					"type": "string",
					"pattern": "^#[0-9a-f]{6}(?:[0-9a-f]{2})?$"
				},
				"dangerHover": {
					"type": "string",
					"pattern": "^#[0-9a-f]{6}(?:[0-9a-f]{2})?$",
					"description": "Destructive button hover fill. Optional: defaults to danger darkened 12% toward black."
				},
				"onDanger": {
					"type": "string",
					"pattern": "^#[0-9a-f]{6}(?:[0-9a-f]{2})?$",
					"description": "Label on the destructive fills. Optional: defaults to the palette's text or background colour, whichever reads better on danger and dangerHover."
				},
				"warning": {
					"type": "string",
					"pattern": "^#[0-9a-f]{6}(?:[0-9a-f]{2})?$"
				}
			},
			"required": [
				"accent",
				"accentHover",
				"accentSolid",
				"onAccent",
				"bubbleAccent",
				"background",
				"header",
				"content",
				"sidebar",
				"input",
				"elevated",
				"hover",
				"border",
				"borderStrong",
				"text",
				"muted",
				"hint",
				"selection",
				"selectionForeground",
				"editorSelection",
				"editorSelectionForeground",
				"info",
				"success",
				"danger",
				"warning"
			],
			"additionalProperties": false
		},
		"ansi": {
			"type": "object",
			"properties": {
				"black": {
					"type": "string",
					"pattern": "^#[0-9a-f]{6}(?:[0-9a-f]{2})?$"
				},
				"red": {
					"type": "string",
					"pattern": "^#[0-9a-f]{6}(?:[0-9a-f]{2})?$"
				},
				"green": {
					"type": "string",
					"pattern": "^#[0-9a-f]{6}(?:[0-9a-f]{2})?$"
				},
				"yellow": {
					"type": "string",
					"pattern": "^#[0-9a-f]{6}(?:[0-9a-f]{2})?$"
				},
				"blue": {
					"type": "string",
					"pattern": "^#[0-9a-f]{6}(?:[0-9a-f]{2})?$"
				},
				"magenta": {
					"type": "string",
					"pattern": "^#[0-9a-f]{6}(?:[0-9a-f]{2})?$"
				},
				"cyan": {
					"type": "string",
					"pattern": "^#[0-9a-f]{6}(?:[0-9a-f]{2})?$"
				},
				"white": {
					"type": "string",
					"pattern": "^#[0-9a-f]{6}(?:[0-9a-f]{2})?$"
				},
				"brightBlack": {
					"type": "string",
					"pattern": "^#[0-9a-f]{6}(?:[0-9a-f]{2})?$"
				},
				"brightRed": {
					"type": "string",
					"pattern": "^#[0-9a-f]{6}(?:[0-9a-f]{2})?$"
				},
				"brightGreen": {
					"type": "string",
					"pattern": "^#[0-9a-f]{6}(?:[0-9a-f]{2})?$"
				},
				"brightYellow": {
					"type": "string",
					"pattern": "^#[0-9a-f]{6}(?:[0-9a-f]{2})?$"
				},
				"brightBlue": {
					"type": "string",
					"pattern": "^#[0-9a-f]{6}(?:[0-9a-f]{2})?$"
				},
				"brightMagenta": {
					"type": "string",
					"pattern": "^#[0-9a-f]{6}(?:[0-9a-f]{2})?$"
				},
				"brightCyan": {
					"type": "string",
					"pattern": "^#[0-9a-f]{6}(?:[0-9a-f]{2})?$"
				},
				"brightWhite": {
					"type": "string",
					"pattern": "^#[0-9a-f]{6}(?:[0-9a-f]{2})?$"
				}
			},
			"required": [
				"black",
				"red",
				"green",
				"yellow",
				"blue",
				"magenta",
				"cyan",
				"white",
				"brightBlack",
				"brightRed",
				"brightGreen",
				"brightYellow",
				"brightBlue",
				"brightMagenta",
				"brightCyan",
				"brightWhite"
			],
			"additionalProperties": false
		},
		"syntax": {
			"type": "object",
			"properties": {
				"foreground": {
					"type": "string",
					"pattern": "^#[0-9a-f]{6}(?:[0-9a-f]{2})?$"
				},
				"comment": {
					"type": "string",
					"pattern": "^#[0-9a-f]{6}(?:[0-9a-f]{2})?$"
				},
				"commentDoc": {
					"type": "string",
					"pattern": "^#[0-9a-f]{6}(?:[0-9a-f]{2})?$"
				},
				"keyword": {
					"type": "string",
					"pattern": "^#[0-9a-f]{6}(?:[0-9a-f]{2})?$"
				},
				"string": {
					"type": "string",
					"pattern": "^#[0-9a-f]{6}(?:[0-9a-f]{2})?$"
				},
				"number": {
					"type": "string",
					"pattern": "^#[0-9a-f]{6}(?:[0-9a-f]{2})?$"
				},
				"regexp": {
					"type": "string",
					"pattern": "^#[0-9a-f]{6}(?:[0-9a-f]{2})?$"
				},
				"annotation": {
					"type": "string",
					"pattern": "^#[0-9a-f]{6}(?:[0-9a-f]{2})?$"
				},
				"tag": {
					"type": "string",
					"pattern": "^#[0-9a-f]{6}(?:[0-9a-f]{2})?$"
				},
				"attributeName": {
					"type": "string",
					"pattern": "^#[0-9a-f]{6}(?:[0-9a-f]{2})?$"
				},
				"attributeValue": {
					"type": "string",
					"pattern": "^#[0-9a-f]{6}(?:[0-9a-f]{2})?$"
				},
				"property": {
					"type": "string",
					"pattern": "^#[0-9a-f]{6}(?:[0-9a-f]{2})?$"
				},
				"function": {
					"type": "string",
					"pattern": "^#[0-9a-f]{6}(?:[0-9a-f]{2})?$"
				},
				"type": {
					"type": "string",
					"pattern": "^#[0-9a-f]{6}(?:[0-9a-f]{2})?$"
				},
				"variable": {
					"type": "string",
					"pattern": "^#[0-9a-f]{6}(?:[0-9a-f]{2})?$"
				},
				"constant": {
					"type": "string",
					"pattern": "^#[0-9a-f]{6}(?:[0-9a-f]{2})?$"
				},
				"operator": {
					"type": "string",
					"pattern": "^#[0-9a-f]{6}(?:[0-9a-f]{2})?$"
				},
				"punctuation": {
					"type": "string",
					"pattern": "^#[0-9a-f]{6}(?:[0-9a-f]{2})?$"
				},
				"inserted": {
					"type": "string",
					"pattern": "^#[0-9a-f]{6}(?:[0-9a-f]{2})?$"
				},
				"deleted": {
					"type": "string",
					"pattern": "^#[0-9a-f]{6}(?:[0-9a-f]{2})?$"
				},
				"changed": {
					"type": "string",
					"pattern": "^#[0-9a-f]{6}(?:[0-9a-f]{2})?$"
				}
			},
			"required": [
				"foreground",
				"comment",
				"commentDoc",
				"keyword",
				"string",
				"number",
				"regexp",
				"annotation",
				"tag",
				"attributeName",
				"attributeValue",
				"property",
				"function",
				"type",
				"variable",
				"constant",
				"operator",
				"punctuation",
				"inserted",
				"deleted",
				"changed"
			],
			"additionalProperties": false
		}
	},
	"required": [
		"schemaVersion",
		"id",
		"label",
		"order",
		"appearance",
		"contrast",
		"colors",
		"ansi",
		"syntax"
	],
	"additionalProperties": false,
	"title": "ThinkRail theme manifest",
	"description": "A complete, declarative ThinkRail UI, terminal, and syntax palette. Selected-text foreground overrides may be null to retain native behavior."
}
